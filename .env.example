# =============================================================================
# KixiHost — .env.example
# Apenas placeholders. NUNCA colocar credenciais reais neste ficheiro
# nem no GitHub. Em produção, usar GitHub Actions Secrets / Secret Manager.
# =============================================================================

# --- APP ---------------------------------------------------------------
APP_NAME=KixiHost
APP_URL=https://kixihost.ao
API_URL=https://api.kixihost.ao
NODE_ENV=development

# --- DATABASE ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/kixihost

# --- REDIS ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- AUTH ------------------------------------------------------------------
SESSION_SECRET=
ENCRYPTION_KEY=

# --- GITHUB (OAuth para login + GitHub App para autorização de repos) -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- PAYPAY AO (usar exclusivamente a documentação oficial) ---------------
# Fonte oficial: https://portal.paypayafrica.com/dist/guide/apidoc_pt.html
PAYPAY_API_URL=
PAYPAY_PARTNER_ID=
PAYPAY_SALE_PRODUCT_CODE=
PAYPAY_PRIVATE_KEY=
PAYPAY_PUBLIC_KEY=
PAYPAY_WEBHOOK_URL=

# --- EMIS ------------------------------------------------------------------
EMIS_API_URL=
EMIS_CLIENT_ID=
EMIS_CLIENT_SECRET=

# --- MULTICAIXA --------------------------------------------------------
MULTICAIXA_API_URL=
MULTICAIXA_CLIENT_ID=
MULTICAIXA_CLIENT_SECRET=

# --- CLOUDFLARE (DNS / WAF / CDN / SSL) -------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- INFRASTRUCTURE PROVIDERS --------------------------------------------
DIGITALOCEAN_API_TOKEN=

HETZNER_API_TOKEN=

OVH_ENDPOINT=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- EMAIL ------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=

# --- MONITORING / OBSERVABILITY -------------------------------------------
OTEL_ENDPOINT=
PROMETHEUS_URL=
GRAFANA_URL=

# --- SECURITY ----------------------------------------------------------
AUDIT_LOG_SECRET=
